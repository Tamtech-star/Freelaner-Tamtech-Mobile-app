{
  "expo": {
    "name": "Freelancer-Tamtech",
    "slug": "freelancer-tamtech",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "freelancer-tamtech",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 2,
      "package": "com.tamtechtools.freelancerapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f172a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Freelancer-Tamtech needs access to your photos to upload documents.",
          "cameraPermission": "Freelancer-Tamtech needs access to your camera to capture documents."
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep public class com.reactnativecommunity.picker.** { *; }\n-dontwarn com.reactnativecommunity.picker.**"
          }
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4869a5ef-d2ac-448e-a417-3cc5bfa3350b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "imbeka"
  }
}